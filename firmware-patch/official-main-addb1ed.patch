@@ -445,6 +448,12 @@ void AfeAudioEngine::ProcessingTask() {
         if (bits & kWakeWordEnabled) {
             HandleWakeWordResult(result);
         }
+#if CONFIG_SOUND_EVENT_TISSUE
+        // 抽纸检测旁路：只读拷贝 AFE 输出，不影响唤醒词判定；
+        // 只在待机态生效（Enable(false) 时 Feed 内部直接丢弃）
+        GetTissueSoundDetector().Feed(reinterpret_cast<const int16_t*>(result->data),
